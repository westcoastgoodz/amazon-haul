# Amazon Haul Price Monitor - template (copy to .env)
KEEPA_API_KEY=
KEEPA_DOMAIN=1
PRICE_TYPE=1
REFERENCE_DAYS=90
KEEPA_BATCH_SIZE=40
MAX_NEW_KEEPA_LOOKUPS=40
KEEPA_CACHE_DAYS=7

DISCORD_WEBHOOK=
DISCORD_PING=
CHANNEL_ENABLED_50=true
CHANNEL_ENABLED_60=true
CHANNEL_ENABLED_70=true
CHANNEL_ENABLED_80=true


SELLER_LABEL=Haul
CHANNEL_PREFIX=Haul

ROUTE_MODE=highest
POLL_INTERVAL_SEC=600
MIN_DISCOUNT=50
MAX_DISCOUNT=95
ALERT_COOLDOWN_HOURS=24
NO_REPEAT_SAME_DAY=true
ALLOW_CHEAPER_REPEAT=true
MAX_ALERTS_PER_TIER=5

MIN_ORIGINAL_PRICE=15
MIN_HAUL_PRICE=3
MAX_HAUL_PRICE=25
MIN_SAVINGS=8
MIN_TRACKING_DAYS=60
REQUIRE_BRAND=true
EXCLUDE_GENERIC_BRAND=true
MIN_REVIEW_COUNT=0
MIN_RATING=0
INCLUDE_CATEGORIES=
EXCLUDE_CATEGORIES=7141123011,11055981,283155,133140011,165793011,2617941011,2335752011,468642,2625373011,229534,16310101,165796011,3367581,3290252011,5174
INCLUDE_BRANDS=
EXCLUDE_BRANDS=
TITLE_KEYWORDS=
EXCLUDE_KEYWORDS=

HAUL_KEYWORDS=automotive,car accessories,tools,home improvement,electronics,kitchen,office,pet supplies,sports and outdoors,industrial and scientific
HAUL_EXTRA_URLS=
HAUL_PAGES=2
HAUL_MAX_ITEMS=1200
HAUL_REQUEST_DELAY=1.2
HAUL_TIMEOUT_SEC=45
HAUL_RETRIES=2
PROXY_URL=
SCRAPER_USER_AGENT=
INCLUDE_GRAPH=true
LOG_LEVEL=INFO
DATA_DIR=
